{
  "version": 2,
  "buildCommand": "cd landingpage && npm install && npm run build",
  "outputDirectory": "landingpage/.next",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/upload",
      "destination": "http://localhost:3001"
    },
    {
      "source": "/plugin/:path*",
      "destination": "http://localhost:3002/plugin/:path*"
    }
  ]
} 