package views

// Home renders the main search page template with HTMX-enabled live autocomplete functionality.
// Features:
// - Search input with autocomplete
// - HTMX-powered live search results
// - Keyboard navigation support
// - Mobile-responsive design
templ Home() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<script src="https://unpkg.com/@tailwindcss/browser@4"></script>
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			<title>TravelX - Explore the World</title>
		</head>
		<body class="bg-gray-100 min-h-screen">
			<div class="relative">
				<div class="absolute inset-0 z-0 pointer-events-none">
					<div class="absolute top-0 left-0 w-1/2 h-1/2 bg-blue-800 opacity-20 transform -rotate-45"></div>
					<div class="absolute bottom-0 right-0 w-2/3 h-2/3 bg-blue-700 opacity-20 transform rotate-45"></div>
				</div>
				<!-- Background Pattern -->
				<div class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,white,transparent)] -z-10"></div>
				<!-- Hero Section -->
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20">
					<div class="text-center">
						<h1 class="text-6xl font-bold text-white mb-6">
							Discover Your Next
							<span class="block text-cyan-300">Adventure</span>
						</h1>
						<p class="text-xl text-white-700 mb-12">Find local experiences in any country around the world</p>
						<!-- Search Box -->
						<div class="max-w-2xl mx-auto">
							<form class="relative group" hx-get="/search/countries" hx-trigger="input delay:300ms from:input" hx-target="#location_autocomplete">
								<div class="relative">
									<input
										type="text"
										name="search"
										placeholder="Where would you like to go?"
										class="w-full px-6 py-4 text-lg bg-blue-800 bg-opacity-80 backdrop-blur border-2 border-blue-700 rounded-full shadow-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 ease-in-out text-blue-100 placeholder-blue-300"
										autofocus
									/>
									<div class="absolute right-4 top-1/2 -translate-y-1/2 text-blue-400">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
										</svg>
									</div>
								</div>
								<ul id="location_autocomplete" class="hidden group-focus-within:block absolute z-50 mt-2 w-full bg-blue-900 backdrop-blur-sm shadow-lg rounded-lg text-white overflow-hidden transition-all duration-300 divide-y divide-blue-700"></ul>
							</form>
						</div>
					</div>
				</div>
				<section class="py-20 relative overflow-hidden">
					<div class="absolute inset-0 z-0 pointer-events-none">
						<div class="absolute top-0 right-0 w-1/3 h-1/3 bg-blue-600 opacity-10 transform rotate-45"></div>
						<div class="absolute bottom-0 left-0 w-1/4 h-1/4 bg-blue-800 opacity-10 transform -rotate-12"></div>
					</div>
					<div class="container mx-auto px-4 relative z-10">
						<h2 class="text-4xl font-bold mb-12 text-center text-white">Featured Destinations</h2>
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
							<div class="city-card group relative aspect-square w-full overflow-hidden rounded-lg cursor-pointer bg-white shadow-lg">
								<div class="relative h-full w-full">
									<img
										src="https://nomads.com/cdn-cgi/image/format=auto,fit=cover,width=600,height=300,quality=75/assets/img/places/bangkok-thailand.jpg"
										alt="Bangkok cityscape"
										class="h-full w-full object-cover"
									/>

									<button
										class="heart-button absolute top-4 right-4 z-20 rounded-full p-2 transition-all hover:scale-110 active:scale-95 bg-black/20 hover:bg-black/40 aria-[pressed=true]:fill-red-500 aria-[pressed=true]:stroke-red-500"
										aria-pressed="false"
										hx-post="/like"
										hx-trigger="click"
										hx-swap="none"
										onclick="this.setAttribute('aria-pressed', this.getAttribute('aria-pressed') === 'true' ? 'false' : 'true')"
									>
										<svg 
											class="h-5 w-5 transition-colors stroke-white stroke-2 fill-none"
											viewBox="0 0 24 24"
											xmlns="http://www.w3.org/2000/svg"
										>
											<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
										</svg>
									</button>

									<div class="absolute inset-0 transition-colors duration-300 bg-gradient-to-t from-black/60 to-transparent group-hover:bg-black/70"></div>

									<div class="absolute inset-0 transition-all duration-300 group-hover:opacity-0 group-hover:translate-y-4">
										<div class="absolute bottom-4 left-4 text-white z-10">
											<h2 class="text-3xl font-bold">Bangkok</h2>
											<h3 class="text-lg opacity-90">Thailand</h3>
										</div>

										<div class="absolute bottom-4 right-4 text-white text-right">
											<p class="text-2xl font-bold">$1,499 / mo</p>
											<p class="text-xs tracking-wide opacity-90">FOR A NOMAD</p>
										</div>
									</div>

									<div class="absolute inset-0 flex items-center opacity-0 translate-y-4 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
										<div class="w-full space-y-6 px-8">
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">⭐️</span>
													<span class="font-medium">Overall</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="transition-[width] duration-700 ease-out h-full w-0 rounded-full bg-emerald-500 shadow-lg [style*='--target-width:90%']"></div>
												</div>
											</div>
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">💵</span>
													<span class="font-medium">Cost</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="transition-[width] duration-700 ease-out h-full w-0 rounded-full bg-emerald-500 shadow-lg [style*='--target-width:100%']"></div>
												</div>
											</div>
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">📡</span>
													<span class="font-medium">Internet</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="transition-[width] duration-700 ease-out h-full w-0 rounded-full bg-red-500 shadow-lg [style*='--target-width:40%']"></div>
												</div>
											</div>
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">👍</span>
													<span class="font-medium">Liked</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="transition-[width] duration-700 ease-out h-full w-0 rounded-full bg-yellow-500 shadow-lg [style*='--target-width:60%']"></div>
												</div>
											</div>
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">👮</span>
													<span class="font-medium">Safety</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="transition-[width] duration-700 ease-out h-full w-0 rounded-full bg-emerald-500 shadow-lg [style*='--target-width:80%']"></div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</section>
			</div>
		</body>
	</html>
}
