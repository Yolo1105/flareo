package views

// Ecommerce renders the country detail page template
// Features:
// - Country header with hero section
// - Popular and all services sections
// - Star rating system
// - Consistent styling with main site
templ Ecommerce(country string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ country } - TravelX</title>
			<script src="https://unpkg.com/@tailwindcss/browser@4"></script>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>
		</head>
		<body class="bg-gradient-to-r from-blue-400 to-purple-500 min-h-screen">
			<!-- Header -->
			<header class="bg-white shadow-lg">
				<div class="container mx-auto px-6 py-4 flex justify-between items-center">
					<a href="/" class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">TravelX</a>
					<nav>
						<ul class="flex space-x-6">
							<li><a href="/" class="hover:text-blue-600 transition duration-200">Home</a></li>
							<li><a href="#services" class="hover:text-blue-600 transition duration-200">Services</a></li>
						</ul>
					</nav>
				</div>
			</header>
			<!-- Hero Section -->
			<section class="bg-white/90 backdrop-blur-sm shadow-2xl mt-8 mx-4 md:mx-auto max-w-6xl rounded-xl overflow-hidden">
				<div class="container mx-auto px-6 py-16 text-center">
					<h1 class="text-5xl font-extrabold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent mb-4">Welcome to { country }</h1>
					<p class="text-xl text-gray-600">Discover amazing local experiences and services</p>
				</div>
			</section>
			<!-- Featured Vendors -->
			<section class="py-12">
				<div class="container mx-auto">
					<h3 class="text-3xl font-semibold text-center mb-8">Featured Vendors</h3>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6 px-6">
						<!-- Vendor Card -->
						<div class="bg-white p-6 rounded-lg shadow-md text-center">
							<img src="https://via.placeholder.com/100" alt="Vendor" class="w-24 h-24 mx-auto rounded-full"/>
							<h4 class="text-lg font-semibold mt-4">John's Art Studio</h4>
							<p class="text-gray-600 text-sm">Custom illustrations & graphic design.</p>
							<button class="mt-4 bg-indigo-600 text-white px-4 py-2 rounded">View Store</button>
						</div>
						<div class="bg-white p-6 rounded-lg shadow-md text-center">
							<img src="https://via.placeholder.com/100" alt="Vendor" class="w-24 h-24 mx-auto rounded-full"/>
							<h4 class="text-lg font-semibold mt-4">Sarah’s Handmade Crafts</h4>
							<p class="text-gray-600 text-sm">Handmade jewelry & decor.</p>
							<button class="mt-4 bg-indigo-600 text-white px-4 py-2 rounded">View Store</button>
						</div>
						<div class="bg-white p-6 rounded-lg shadow-md text-center">
							<img src="https://via.placeholder.com/100" alt="Vendor" class="w-24 h-24 mx-auto rounded-full"/>
							<h4 class="text-lg font-semibold mt-4">TechFix Solutions</h4>
							<p class="text-gray-600 text-sm">Website development & IT support.</p>
							<button class="mt-4 bg-indigo-600 text-white px-4 py-2 rounded">View Store</button>
						</div>
					</div>
				</div>
			</section>
			<!-- Popular Services -->
			<section class="py-12 bg-gray-200">
				<div class="container mx-auto">
					<h3 class="text-3xl font-semibold text-center mb-8">Popular Services</h3>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6 px-6">
						<!-- Service Card -->
						<div class="bg-white p-6 rounded-lg shadow-md">
							<img src="https://via.placeholder.com/300x200" alt="Service" class="w-full h-40 object-cover rounded"/>
							<h4 class="text-lg font-semibold mt-4">Logo Design</h4>
							<p class="text-gray-600 text-sm">By John's Art Studio</p>
							<p class="mt-2 font-bold">$50</p>
							<button class="mt-4 bg-indigo-600 text-white px-4 py-2 rounded">Order Now</button>
						</div>
						<div class="bg-white p-6 rounded-lg shadow-md">
							<img src="https://via.placeholder.com/300x200" alt="Service" class="w-full h-40 object-cover rounded"/>
							<h4 class="text-lg font-semibold mt-4">Custom Necklace</h4>
							<p class="text-gray-600 text-sm">By Sarah’s Handmade Crafts</p>
							<p class="mt-2 font-bold">$25</p>
							<button class="mt-4 bg-indigo-600 text-white px-4 py-2 rounded">Order Now</button>
						</div>
						<div class="bg-white p-6 rounded-lg shadow-md">
							<img src="https://via.placeholder.com/300x200" alt="Service" class="w-full h-40 object-cover rounded"/>
							<h4 class="text-lg font-semibold mt-4">Website Audit</h4>
							<p class="text-gray-600 text-sm">By TechFix Solutions</p>
							<p class="mt-2 font-bold">$100</p>
							<button class="mt-4 bg-indigo-600 text-white px-4 py-2 rounded">Order Now</button>
						</div>
					</div>
				</div>
			</section>
			<!-- Footer -->
			<footer class="bg-white/90 backdrop-blur-sm shadow-lg py-6">
				<div class="container mx-auto px-6 text-center text-gray-600">
					<p>&copy; 2024 TravelX. All rights reserved.</p>
				</div>
			</footer>
		</body>
	</html>
}
