package views

import "fmt"

// Ecommerce renders the country detail page template with an integrated HTMX search form in the header.
// Features:
// - Country header with hero section
// - Popular and all services sections
// - Star rating system
templ Ecommerce(country string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ country } - TravelX</title>
			<script src="https://unpkg.com/@tailwindcss/browser@4"></script>
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>
		</head>
		<body class="bg-gray-100 min-h-screen">
			<!-- Header -->
			<header class="bg-white shadow-md p-4 sticky top-0 z-50">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex items-center justify-between">
						<a href="/" class="text-2xl font-bold text-blue-600">TravelX</a>
						<div class="flex-1 max-w-xl mx-8">
							<form class="relative group" hx-get="/search/countries" hx-trigger="input delay:300ms from:input" hx-target="#nav_location_autocomplete">
								<input
									type="text"
									name="search"
									placeholder="Search for another country..."
									class="w-full px-6 py-4 text-lg bg-white bg-opacity-90 backdrop-blur border-2 border-gray-200 rounded-full shadow-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 ease-in-out text-gray-800 placeholder-gray-400"
								/>
								<ul id="nav_location_autocomplete" class="hidden group-focus-within:block absolute z-50 mt-2 w-full bg-white shadow-lg rounded-lg text-gray-800 overflow-hidden transition-all duration-300 divide-y divide-gray-100"></ul>
							</form>
						</div>
					</div>
				</div>
			</header>
			<!-- Hero Section -->
			<section class="relative">
				<div class="absolute inset-0 z-0 pointer-events-none">
					<div class="absolute top-0 left-0 w-1/2 h-1/2 bg-blue-800 opacity-20 transform -rotate-45"></div>
					<div class="absolute bottom-0 right-0 w-2/3 h-2/3 bg-blue-700 opacity-20 transform rotate-45"></div>
				</div>
				<div class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,white,transparent)] -z-10"></div>
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20">
					<div class="text-center">
						<h1 class="text-6xl font-bold text-gray-900 mb-6">
							Explore <span class="text-blue-600">{ country }</span>
						</h1>
						<p class="text-xl text-gray-700 mb-12">Discover amazing local experiences and services</p>
					</div>
				</div>
			</section>
			<section class="py-20 relative overflow-hidden">
				<div class="absolute inset-0 z-0 pointer-events-none">
					<div class="absolute top-0 right-0 w-1/3 h-1/3 bg-blue-600 opacity-10 transform rotate-45"></div>
					<div class="absolute bottom-0 left-0 w-1/4 h-1/4 bg-blue-800 opacity-10 transform -rotate-12"></div>
				</div>
				<div class="container mx-auto px-4 relative z-10">
					<h2 class="text-4xl font-bold mb-12 text-center text-gray-900">Popular Services</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
						for i := 0; i < 3; i++ {
							<div class="city-card group relative aspect-square w-full overflow-hidden rounded-lg cursor-pointer bg-white shadow-lg">
								<div class="relative h-full w-full">
									<img
										src={ fmt.Sprintf("https://source.unsplash.com/800x600/?%s,tourism", country) }
										alt="Service"
										class="h-full w-full object-cover"
									/>
									<button
										class="heart-button absolute top-4 right-4 z-20 rounded-full p-2 transition-all hover:scale-110 active:scale-95 bg-black/20 hover:bg-black/40 aria-[pressed=true]:fill-red-500 aria-[pressed=true]:stroke-red-500"
										aria-pressed="false"
										hx-post="/like"
										hx-trigger="click"
										hx-swap="none"
										onclick="this.setAttribute('aria-pressed', this.getAttribute('aria-pressed') === 'true' ? 'false' : 'true')"
									>
										<svg 
											class="h-5 w-5 transition-colors stroke-white stroke-2 fill-none"
											viewBox="0 0 24 24"
											xmlns="http://www.w3.org/2000/svg"
										>
											<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
										</svg>
									</button>
									<div class="absolute inset-0 transition-colors duration-300 bg-gradient-to-t from-black/60 to-transparent group-hover:bg-black/70"></div>
									<div class="absolute inset-0 transition-all duration-300 group-hover:opacity-0 group-hover:translate-y-4">
										<div class="absolute bottom-4 left-4 text-white z-10">
											<h2 class="text-3xl font-bold">Local Tour Guide</h2>
											<h3 class="text-lg opacity-90">Professional Guide</h3>
										</div>
										<div class="absolute bottom-4 right-4 text-white text-right">
											<p class="text-2xl font-bold">$99</p>
											<p class="text-xs tracking-wide opacity-90">PER PERSON</p>
										</div>
									</div>
									<div class="absolute inset-0 flex items-center opacity-0 translate-y-4 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
										<div class="w-full space-y-6 px-8">
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">⭐️</span>
													<span class="font-medium">Rating</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="h-full w-[90%] rounded-full bg-emerald-500 shadow-lg transition-all duration-700 ease-out"></div>
												</div>
											</div>
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">💵</span>
													<span class="font-medium">Value</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="h-full w-[85%] rounded-full bg-emerald-500 shadow-lg transition-all duration-700 ease-out"></div>
												</div>
											</div>
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">👍</span>
													<span class="font-medium">Reviews</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="h-full w-[95%] rounded-full bg-emerald-500 shadow-lg transition-all duration-700 ease-out"></div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			</section>
			<section class="py-20 relative overflow-hidden bg-gray-50">
				<div class="absolute inset-0 z-0 pointer-events-none">
					<div class="absolute top-0 left-0 w-1/3 h-1/3 bg-blue-600 opacity-10 transform -rotate-45"></div>
					<div class="absolute bottom-0 right-0 w-1/4 h-1/4 bg-blue-800 opacity-10 transform rotate-12"></div>
				</div>
				<div class="container mx-auto px-4 relative z-10">
					<h2 class="text-4xl font-bold mb-12 text-center text-gray-900">All Services</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
						for i := 0; i < 8; i++ {
							<div class="city-card group relative aspect-square w-full overflow-hidden rounded-lg cursor-pointer bg-white shadow-lg">
								<div class="relative h-full w-full">
									<img
										src={ fmt.Sprintf("https://source.unsplash.com/800x600/?%s,adventure", country) }
										alt="Service"
										class="h-full w-full object-cover"
									/>
									<button
										class="heart-button absolute top-4 right-4 z-20 rounded-full p-2 transition-all hover:scale-110 active:scale-95 bg-black/20 hover:bg-black/40 aria-[pressed=true]:fill-red-500 aria-[pressed=true]:stroke-red-500"
										aria-pressed="false"
										hx-post="/like"
										hx-trigger="click"
										hx-swap="none"
										onclick="this.setAttribute('aria-pressed', this.getAttribute('aria-pressed') === 'true' ? 'false' : 'true')"
									>
										<svg 
											class="h-5 w-5 transition-colors stroke-white stroke-2 fill-none"
											viewBox="0 0 24 24"
											xmlns="http://www.w3.org/2000/svg"
										>
											<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
										</svg>
									</button>
									<div class="absolute inset-0 transition-colors duration-300 bg-gradient-to-t from-black/60 to-transparent group-hover:bg-black/70"></div>
									<div class="absolute inset-0 transition-all duration-300 group-hover:opacity-0 group-hover:translate-y-4">
										<div class="absolute bottom-4 left-4 text-white z-10">
											<h2 class="text-3xl font-bold">Adventure Package</h2>
											<h3 class="text-lg opacity-90">Adventure Guide</h3>
										</div>
										<div class="absolute bottom-4 right-4 text-white text-right">
											<p class="text-2xl font-bold">$149</p>
											<p class="text-xs tracking-wide opacity-90">PER PERSON</p>
										</div>
									</div>
									<div class="absolute inset-0 flex items-center opacity-0 translate-y-4 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
										<div class="w-full space-y-6 px-8">
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">⭐️</span>
													<span class="font-medium">Rating</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="h-full w-[90%] rounded-full bg-emerald-500 shadow-lg transition-all duration-700 ease-out"></div>
												</div>
											</div>
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">💵</span>
													<span class="font-medium">Value</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="h-full w-[85%] rounded-full bg-emerald-500 shadow-lg transition-all duration-700 ease-out"></div>
												</div>
											</div>
											<div class="space-y-2">
												<div class="text-base text-white flex items-center gap-2">
													<span class="text-lg">👍</span>
													<span class="font-medium">Reviews</span>
												</div>
												<div class="h-3 w-full rounded-full bg-white/20">
													<div class="h-full w-[95%] rounded-full bg-emerald-500 shadow-lg transition-all duration-700 ease-out"></div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			</section>
			<!-- Footer -->
			<footer class="bg-white text-gray-600 py-4 shadow-md relative overflow-hidden">
				<div class="absolute inset-0 z-0 pointer-events-none">
					<div class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-blue-800 opacity-10 transform rotate-45"></div>
					<div class="absolute top-0 right-0 w-1/4 h-1/4 bg-blue-700 opacity-10 transform -rotate-12"></div>
					<div class="absolute top-1/2 left-1/4 w-1/5 h-1/5 bg-blue-600 opacity-10 transform -translate-y-1/2 rotate-45"></div>
				</div>
				<div class="container mx-auto px-6 relative z-10 text-center">
					<p>&copy; 2024 TravelX. All rights reserved.</p>
				</div>
			</footer>
		</body>
	</html>
}
