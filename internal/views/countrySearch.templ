package views

// CountrySearchList renders the dropdown list of matching countries
// The first result gets special treatment for keyboard navigation
// Each country links to its detail page
templ CountrySearchList(countries []string) {
	for i, country := range countries {
		if i == 0 {
			<li class="px-6 py-3 hover:bg-blue-800 cursor-pointer transition-colors duration-150 ease-in-out">
				<a href={ templ.SafeURL("/country/" + country) } class="block w-full h-full text-white hover:text-cyan-300" tabindex="0">
					{ country }
				</a>
			</li>
		} else {
			<li class="px-6 py-3 hover:bg-blue-800 cursor-pointer transition-colors duration-150 ease-in-out">
				<a href={ templ.SafeURL("/country/" + country) } class="block w-full h-full text-white hover:text-cyan-300">
					{ country }
				</a>
			</li>
		}
	}
}

// CountryNotFound renders the error page shown when a country doesn't exist
// Provides a link back to the home page
templ CountryNotFound() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<script src="https://unpkg.com/@tailwindcss/browser@4"></script>
			<title>Country Not Found - TravelX</title>
		</head>
		<body class="bg-gradient-to-r from-blue-400 to-purple-500 flex items-center justify-center min-h-screen p-4">
			<div class="w-full max-w-2xl bg-white rounded-xl shadow-2xl p-8 text-center">
				<h1 class="text-4xl font-bold mb-4 text-gray-800">Country Not Found</h1>
				<p class="text-gray-600 mb-6">Sorry, we couldn't find the country you're looking for.</p>
				<a href="/" class="inline-block bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 transition duration-200">
					Return to Home
				</a>
			</div>
		</body>
	</html>
}
