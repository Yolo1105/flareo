# Postgres connection. Matches the docker-compose default.
DATABASE_URL="postgresql://flareo:flareo@localhost:5432/flareo"

# NextAuth session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth credentials.
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Base URL of the running app. Keep the default for local dev.
NEXTAUTH_URL="http://localhost:3000"

# Optional. Email or GitHub login of the user to auto promote to admin on seed.
# If unset, seed creates no admin user and the first human to sign in has the
# "user" role. Promote manually afterward with:
#   npx prisma studio
ADMIN_EMAIL=""

# ─── Canary rebuild pipeline ───────────────────────────────────
# Needed by scripts/canary/rebuild-canary.sh and the
# .github/workflows/canary-rebuild.yml workflow. Set locally in .env.local
# for dev, and as GitHub Actions secrets for the scheduled runs.

# AWS credentials for ECR Public. The IAM user only needs
# AmazonElasticContainerRegistryPublicFullAccess.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
# Your ECR Public registry URL, e.g. public.ecr.aws/XXXXXX/flareo
ECR_PUBLIC_URL=""

# Cloudflare R2 for SBOM, Trivy report, and Dockerfile storage.
# Two separate buckets by convention — submissions (user uploads) vs
# artifacts (pipeline outputs). The worker uses the matching names,
# see flareo-worker/.env.example.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Submission bucket: stores Dockerfiles uploaded via /app/publish.
# Keys look like submissions/<submission_id>/Dockerfile.
R2_BUCKET_SUBMISSIONS="flareo-submissions"
# Artifact bucket: SBOMs, Trivy reports, build logs. Used by the canary
# rebuild workflow and the build worker on success.
R2_BUCKET_NAME="flareo-artifacts"

# ─── Transactional email (Resend) ──────────────────────────────
RESEND_API_KEY=""

# ─── Error tracking (Sentry) ───────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Billing (Stripe) ──────────────────────────────────────────
# Paid tier checkout, customer portal, and webhook handler.
# All three env vars are optional: if STRIPE_SECRET_KEY is unset,
# the billing page renders a "coming soon" disabled CTA and quota
# enforcement still works — every user stays on the free plan.
# Use test-mode keys (sk_test_...) in dev, live-mode (sk_live_...)
# in production.
STRIPE_SECRET_KEY=""
# Price id for the Pro tier (€12/mo). Created in the Stripe
# dashboard under Products -> Pro -> Pricing. Different id per
# environment (test vs live).
STRIPE_PRICE_ID_PRO=""
# Webhook signing secret (whsec_...). Get this from the Stripe
# dashboard under Developers -> Webhooks -> your endpoint ->
# Signing secret. Required for /api/v1/billing/webhook to verify
# that events really came from Stripe.
STRIPE_WEBHOOK_SECRET=""

# ─── Analytics (Plausible) ──────────────────────────────────────
# Privacy-friendly page analytics. Cookieless, no PII collected,
# GDPR/CCPA compliant by design.
# Unset in dev and preview deploys so we don't pollute real stats.
# Set in production to "flareo.dev" (or whatever the live domain is).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Optional: override if self-hosting Plausible (defaults to the
# hosted plausible.io script URL).
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=""
