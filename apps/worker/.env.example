# Worker environment template. Copy to .env for local dev, or to
# /etc/flareo-worker/env on the build host. In production, /etc/...
# is root:flareo-worker 0640 and loaded by systemd via
# EnvironmentFile=.

# === Required ===

# Same Postgres instance as the main app.
DATABASE_URL=postgres://user:password@host:5432/flareo

# Cloudflare R2 credentials. Submissions bucket holds the raw
# Dockerfile uploads; artifacts bucket holds SBOMs and build logs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_SUBMISSIONS=flareo-submissions
R2_BUCKET_ARTIFACTS=flareo-artifacts

# ECR Public — the registry we push signed images to. us-east-1 is
# ECR Public's only region.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ECR_REGISTRY=public.ecr.aws/flareo

# === Optional ===

# Identifies this worker in structured logs and audit rows. Useful
# if we ever run more than one (second host = second id).
WORKER_ID=hetzner-01

# Poll cadence. Lower = faster queue response, higher = less load.
# 30 seconds matches the spec.
POLL_INTERVAL_SEC=30

# Build timeout. 600000ms = 10min. Hard cap enforced via timeout(1)
# on the docker build process.
BUILD_TIMEOUT_MS=600000

# Where the worker writes its heartbeat. Main app polls a file read
# of this path (via a shared filesystem or ssh) to decide if the
# worker is alive.
HEARTBEAT_FILE=/var/lib/flareo-worker/heartbeat

# Main app base URL + shared secret. Used to fire-and-forget POST a
# "build completed" event so the main app can send the decision email
# without the worker needing its own Resend credentials.
MAIN_APP_URL=https://flareo.dev
MAIN_APP_WORKER_SECRET=

# Sentry DSN. Optional but recommended — lets me see worker errors
# at 8AM instead of waiting for a user complaint.
SENTRY_DSN=

# Cosign keyless OIDC. On Hetzner we use the GitHub Actions OIDC
# token stashed in this env var; the worker refreshes it periodically.
COSIGN_OIDC_TOKEN=
COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com
