{
  "name": "flareo",
  "version": "0.5.0",
  "private": true,
  "description": "Container supply-chain verification platform — monorepo containing the web app, build worker, CLI, and deploy configs. Root version matches apps/web (user-visible). apps/worker and packages/cli keep independent versions because they are released separately.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "build:web": "npm run build --workspace=apps/web",
    "build:worker": "npm run build --workspace=apps/worker",
    "test:worker": "npm test --workspace=apps/worker",
    "test:web": "npm test --workspace=apps/web",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
